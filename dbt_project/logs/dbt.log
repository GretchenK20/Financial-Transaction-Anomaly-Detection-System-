it_part', 'macro_sql': '{% macro duckdb__split_part(string_text, delimiter_text, part_number) %}\n    string_split({{ string_text }}, {{ delimiter_text }})[ {{ part_number }} ]\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'string_text', 'type': None, 'description': ''}, {'name': 'delimiter_text', 'type': None, 'description': ''}, {'name': 'part_number', 'type': None, 'description': ''}], 'created_at': 1788480585.0798314, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__last_day': {'name': 'duckdb__last_day', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros/utils/lastday.sql', 'original_file_path': 'macros/utils/lastday.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__last_day', 'macro_sql': "{% macro duckdb__last_day(date, datepart) -%}\n\n    {%- if datepart == 'quarter' -%}\n    -- duckdb dateadd does not support quarter interval.\n    cast(\n        {{dbt.dateadd('day', '-1',\n        dbt.dateadd('month', '3', dbt.date_trunc(datepart, date))\n        )}}\n        as date)\n    {%- else -%}\n    {{dbt.default_last_day(date, datepart)}}\n    {%- endif -%}\n\n{%- endmacro %}", 'depends_on': {'macros': ['macro.dbt.dateadd', 'macro.dbt.date_trunc', 'macro.dbt.default_last_day']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'date', 'type': None, 'description': ''}, {'name': 'datepart', 'type': None, 'description': ''}], 'created_at': 1788480585.0805237, 'supported_languages': None}, 'macro.dbt_duckdb.normalize_string_or_list': {'name': 'normalize_string_or_list', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros/utils/normalize.sql', 'original_file_path': 'macros/utils/normalize.sql', 'unique_id': 'macro.dbt_duckdb.normalize_string_or_list', 'macro_sql': '{%- macro normalize_string_or_list(raw, field_name) -%}\n  {%- if raw is none -%}\n    {%- set result = [] -%}\n  {%- elif raw is mapping -%}\n    {{ exceptions.raise_compiler_error(field_name ~ " must be a list of strings or a string") }}\n  {%- elif raw is string -%}\n    {%- set result = [raw] -%}\n  {%- elif raw is sequence -%}\n    {%- set result = raw | list -%}\n  {%- else -%}\n    {{ exceptions.raise_compiler_error(field_name ~ " must be a list of strings or a string") }}\n  {%- endif -%}\n  {%- for item in result -%}\n    {%- if item is not string -%}\n      {% do exceptions.raise_compiler_error(field_name ~ " list values must be non-empty strings") %}\n    {%- endif -%}\n  {%- endfor -%}\n  {{ return(result) }}\n{%- endmacro -%}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'raw', 'type': None, 'description': ''}, {'name': 'field_name', 'type': None, 'description': ''}], 'created_at': 1788480585.0817785, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__date': {'name': 'duckdb__date', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros/utils/date.sql', 'original_file_path': 'macros/utils/date.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__date', 'macro_sql': '{% macro duckdb__date(year, month, day) -%}\n    make_date({{ year }}, {{ month }}, {{ day }})\n{%- endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'year', 'type': None, 'description': ''}, {'name': 'month', 'type': None, 'description': ''}, {'name': 'day', 'type': None, 'description': ''}], 'created_at': 1788480585.0820758, 'supported_languages': None}, 'macro.dbt_duckdb