raw, "partitioned_by/partition_by") -%}\n\n  {%- if parts | length == 0 -%}\n    {% do exceptions.raise_compiler_error("partitioned_by/partition_by must contain at least one column") %}\n  {%- endif -%}\n\n  {# Apply partitioning only on the final target relation, not staging/intermediate relations. #}\n  {%- if this is defined and config.get(\'materialized\') in [\'table\', \'incremental\']\n      and relation.identifier and this.identifier and relation.identifier != this.identifier -%}\n    {{ return(none) }}\n  {%- endif -%}\n\n  {%- if not adapter.is_ducklake(relation) -%}\n    {% do adapter.warn_once(\n      "partitioned_by/partition_by is only supported for DuckLake relations; ignoring for "\n      ~ relation\n    ) %}\n    {{ return(none) }}\n  {%- endif -%}\n\n  {{ return(parts | join(\', \')) }}\n{%- endmacro %}', 'depends_on': {'macros': ['macro.dbt_duckdb.normalize_string_or_list']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None, 'description': ''}, {'name': 'temporary', 'type': None, 'description': ''}], 'created_at': 1788480584.9916203, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__alter_table_set_partitioned_by': {'name': 'duckdb__alter_table_set_partitioned_by', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros/adapters.sql', 'original_file_path': 'macros/adapters.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__alter_table_set_partitioned_by', 'macro_sql': '{% macro duckdb__alter_table_set_partitioned_by(relation, partitioned_by) -%}\n  alter table {{ relation }} set partitioned by ({{ partitioned_by }});\n{%- endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None,