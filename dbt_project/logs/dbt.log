ategy/validation_helper.sql', 'original_file_path': 'macros/materializations/incremental_strategy/validation_helper.sql', 'unique_id': 'macro.dbt_duckdb.validate_dict_field', 'macro_sql': '{%- macro validate_dict_field(field_value, field_name, errors) -%}\n  {%- if field_value is not none and field_value is not mapping -%}\n    {%- do errors.append(field_name ~ " must be a dictionary, found: " ~ field_value) -%}\n  {%- endif -%}\n{%- endmacro -%}\n\n', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'field_value', 'type': None, 'description': ''}, {'name': 'field_name', 'type': None, 'description': ''}, {'name': 'errors', 'type': None, 'description': ''}], 'created_at': 1788480585.0633605, 'supported_languages': None}, 'macro.dbt_duckdb.normalize_incremental_predicates': {'name': 'normalize_incremental_predicates', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros/materializations/incremental_strategy/validation_helper.sql', 'original_file_path': 'macros/materializations/incremental_strategy/validation_helper.sql', 'unique_id': 'macro.dbt_duckdb.normalize_incremental_predicates', 'macro_sql': '{%- macro normalize_incremental_predicates(incremental_predicates) -%}\n  {{ return(normalize_string_or_list(incremental_predicates, "incremental_predicates")) }}\n{%- endmacro -%}', 'depends_on': {'macros': ['macro.dbt_duckdb.normalize_string_or_list']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'incremental_predicates', 'type': None, 'description': ''}], 'created_at': 1788480585.0635788, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__merge_join_clause': {'name': 'duckdb__merge_join_clause', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros/materializations/incremental_strategy/merge.sql', 'original_file_path': 'macros/materializations/incremental_strategy/merge.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__merge_join_clause', 'macro_sql': '{% macro duckdb__merge_join_clause(unique_key, merge_on_using_columns, incremental_predicates) -%}\n    {%- set incremental_filters = [] if incremental_predicates is none else [] + incremental_predicates -%}\n    {%- set join_predicates = [] -%}\n    {%- set using_clause_requested = merge_on_using_columns and merge_on_using_columns | length > 0 -%}\n\n    {%- if not using_clause_requested -%}\n        {% if unique_key %}\n            {% if unique_key is sequence and unique_key is not mapping and unique_key is not string %}\n                {% for key in unique_key %}\n                    {% do join_predicates.append("DBT_INTERNAL_SOURCE." ~ key ~ " = DBT_INTERNAL_DEST." ~ key) %}\n                {% endfor %}\n            {% else %}\n                {% do join_predicates.append("DBT_INTERNAL_SOURCE." ~ unique_key ~ " = DBT_INTERNAL_DEST." ~ unique_key) %}\n            {% endif %}\n        {% else %}\n            {% do join_predicates.append(\'FALSE\') %}\n        {% endif %}\n    {%- endif -%}\n\n    {% if using_clause_requested %}\n        USING ({{ merge_on_using_columns | join(\', \') }})\n        {%- if incremental_filters | length > 0 %}\n        ON ({{ incremental_filters | join(") AND (") }})\n        {%- endif %}\n    {% else %}\n        ON ({{ (join_predicates + incremental_filters) | join(") AND (") }})\n    {% endif %}\n{%- endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'unique_key', 'type': None, 'description': ''}, {'name': 'merge_on_using_columns', 'type': None, 'description': ''}, {'name': 'incremental_predicates', 'type': None, 'description': ''}],